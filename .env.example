# ═══════════════════════════════════════════════════════════
# Whiteboard Video — 文生图 Provider 配置
# ═══════════════════════════════════════════════════════════
# 复制本文件为 .env，填入你使用的平台的 API Key。
# 只有「完整模式」（SRT→视频）需要文生图，单图/批量动画模式不需要。
#
# 选择 provider：取消下面一行的注释，填入平台名
# 可选值: runninghub | openai | replicate | stability
# ═══════════════════════════════════════════════════════════

IMAGE_PROVIDER=runninghub

# ── RunningHub ───────────────────────────────────────────
# 获取: https://www.runninghub.cn/
RUNNINGHUB_API_KEY=your_runninghub_key_here

# ── OpenAI 兼容（官方 / 硅基流动 / OneAPI / New API 等）────────
# 所有兼容 OpenAI Images API 的平台都用这一个 provider，
# 通过 OPENAI_BASE_URL 切换平台，请求/响应格式统一。
#
# OpenAI 官方:     OPENAI_BASE_URL=https://api.openai.com/v1
# 硅基流动:        OPENAI_BASE_URL=https://api.siliconflow.cn/v1
# OneAPI/New API:  OPENAI_BASE_URL=https://your-gateway.com/v1
# Azure OpenAI:    OPENAI_BASE_URL=https://{resource}.openai.azure.com/openai/deployments/{deployment}
#
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=your_openai_key_here
# OPENAI_MODEL=gpt-image-1
# OPENAI_QUALITY=auto
# OPENAI_SIZE=          # 留空自动映射，或手动指定如 1024x1024

# ── Replicate (Flux) ─────────────────────────────────────
# 获取: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=your_replicate_token_here
# REPLICATE_MODEL=black-forest-labs/flux-1.1-pro-ultra

# ── Stability AI (Stable Image Core) ─────────────────────
# 获取: https://platform.stability.ai/
# STABILITY_API_KEY=your_stability_key_here
# STABILITY_OUTPUT_FORMAT=png
# STABILITY_STYLE_PRESET=    # 可选，如 "anime" "photographic" 等
